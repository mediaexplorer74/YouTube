<Page
    x:Class="YouTube.Video"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YouTube"
    xmlns:lvs="using:LibVLCSharp.Platforms.UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Black">

    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Video area -->
        <Grid Grid.Row="0" x:Name="VideoPlayerContainer" Background="Black">
            <VLC:MediaElement x:Name="VlcMediaElement"
                              xmlns:VLC="using:VLC"
                              AreTransportControlsEnabled="True"
                              DoubleTapped="VideoPlayer_DoubleTapped"
                              Background="Black"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">
                <VLC:MediaElement.TransportControls>
                    <VLC:MediaTransportControls/>
                </VLC:MediaElement.TransportControls>
            </VLC:MediaElement>

            <!-- Fullscreen toggle button (overlay, top-right) -->
            <Button x:Name="FullscreenButton"
                    Click="FullscreenButton_Click"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="8"
                    Background="#22000000"
                    BorderBrush="Transparent"
                    Width="40"
                    Height="40">
                <FontIcon Glyph="\uE740" FontFamily="Segoe MDL2 Assets" Foreground="White"/>
            </Button>

            <Grid x:Name="SkipOverlay" Visibility="Collapsed" Background="#80000000" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon x:Name="SkipIcon" Glyph="&#xE111;" FontFamily="Segoe MDL2 Assets" FontSize="48" Foreground="White"/>
                    <TextBlock x:Name="SkipText" Text="10 сек" Foreground="White" FontSize="24" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Bottom: single last comment -->
        <StackPanel Grid.Row="1" x:Name="CommentsPanel" Background="#1A1A1A" Padding="12">
            <Border x:Name="LastCommentContainer" CornerRadius="8" Background="#111111" Padding="12">
                <StackPanel Orientation="Horizontal">
                    <Border Width="36" Height="36" CornerRadius="18" Background="#333" Margin="0,0,8,0">
                        <Image x:Name="LastCommentAuthorImage" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="LastCommentAuthor" Text="username" Foreground="#AAAAAA" FontSize="13"/>
                            <TextBlock x:Name="LastCommentTime" Text="2 часа назад" Foreground="#666666" FontSize="13" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="LastCommentText" Text="Это отличное видео! Очень познавательно..." Foreground="White" FontSize="14" TextWrapping="Wrap" MaxLines="2"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

    </Grid>
</Page>
